{
  "manifest_version": 2,
  "name": "LinkedIn jobs filter",
  "version": "2.0.0",

  "description": "Adds an option to filter jobs based on the language of the description",

  "icons": {
    "48": "icons/icon48.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["./src/content.js"]
    }
  ],
  "permissions": ["storage", "*://*.linkedin.com/*"]
}
